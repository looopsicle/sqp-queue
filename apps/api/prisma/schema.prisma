// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String          @id @default(cuid())
  username     String          @unique
  fullName     String
  email        String          @unique
  phone        String          @default("")
  passwordHash String
  isGuest      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tickets      VisitorTicket[]
  claimedQrs   WorkerQrTicket[]
}

model WorkerQrTicket {
  id                 String    @id @default(cuid())
  claimCode          String    @unique
  posReceiptNumber   String
  attractionId       String
  attractionName     String
  activityName       String
  bundlingName       String?
  adultCount         Int       @default(0)
  childCount         Int       @default(0)
  totalParticipants  Int
  status             String    @default("AVAILABLE") // AVAILABLE | CLAIMED
  issuedByWorker     String
  claimedByAccountId String?
  claimedByAccount   Account?  @relation(fields: [claimedByAccountId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  claimedAt          DateTime?

  @@unique([posReceiptNumber, attractionId])
}

model VisitorTicket {
  id                    String   @id @default(cuid())
  accountId             String
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  claimCode             String?
  receiptId             String
  orderRef              String?
  attractionId          String
  attractionName        String
  guestSummaryHome      String
  guestSummaryMyTickets String
  holderName            String
  membersLabel          String
  validDateLine1        String
  validDateLine2        String
  includesJson          String
  queueStatus           String   @default("not_joined") // not_joined | in_queue | used
  queuePosition         String
  queueNodesJson        String
  estimatedBoardingTime String
  joinedQueueAt         String
  usedDateText          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
