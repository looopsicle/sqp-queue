{
  "name": "sqp-queue",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm run dev --workspace=@app/web\" \"npm run dev --workspace=@app/api\"",
    "dev:web": "npm run dev --workspace=@app/web",
    "dev:api": "npm run dev --workspace=@app/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looopsicle/sqp-queue.git"
  },
